    "def command(args, **kwargs):\n",
    "    if not kwargs.get(\"capture_output\"):\n",
    "        # Pipe child output through Python so Colab displays live progress.\n",
    "        with subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n",
    "                              text=True, bufsize=1, **kwargs) as process:\n",
    "            for line in process.stdout:\n",
    "                print(line, end=\"\", flush=True)\n",
    "            status = process.wait()\n",
    "        if status:\n",
    "            raise subprocess.CalledProcessError(status, args)\n",
    "        return subprocess.CompletedProcess(args, status)\n",
    "    try:\n",
    "        return subprocess.run(args, check=True, **kwargs)\n",
    "    except subprocess.CalledProcessError as error:\n",
    "        if error.stderr:\n",
    "            print(error.stderr)\n",
    "        raise\n",
    "\n",
    "if CONFIG[\"SYNC_REPOSITORY\"]:\n",
    "    if not REPO.exists():\n",
    "        command([\"git\", \"clone\", \"--single-branch\", \"--branch\", CONFIG[\"BRANCH\"],\n",
    "                 CONFIG[\"REPO_URL\"], str(REPO)])\n",
    "    else:\n",
    "        if not (REPO / \".git\").exists():\n",
    "            raise RuntimeError(f\"{REPO} exists but is not a Git checkout. Choose a new REPO_DIR.\")\n",
    "        dirty = subprocess.check_output(\n",
    "            [\"git\", \"-C\", str(REPO), \"status\", \"--porcelain\", \"--untracked-files=no\"], text=True).strip()\n",
    "        if dirty:\n",
    "            raise RuntimeError(\"Runtime checkout has tracked local changes. Preserve them and choose a new REPO_DIR.\")\n",
    "        origin = subprocess.check_output(\n",
    "            [\"git\", \"-C\", str(REPO), \"remote\", \"get-url\", \"origin\"], text=True).strip()\n",
    "        normalize_url = lambda value: value.rstrip(\"/\").removesuffix(\".git\")\n",
    "        if normalize_url(origin) != normalize_url(CONFIG[\"REPO_URL\"]):\n",
    "            raise RuntimeError(\"REPO_DIR points to a different repository. Choose a new directory.\")\n",
    "        command([\"git\", \"-C\", str(REPO), \"fetch\", \"origin\", CONFIG[\"BRANCH\"]])\n",
    "        current = subprocess.check_output(\n",
    "            [\"git\", \"-C\", str(REPO), \"branch\", \"--show-current\"], text=True).strip()\n",
    "        if current != CONFIG[\"BRANCH\"]:\n",
    "            exists = subprocess.run([\"git\", \"-C\", str(REPO), \"show-ref\", \"--verify\", \"--quiet\",\n",
    "                                     \"refs/heads/\" + CONFIG[\"BRANCH\"]]).returncode == 0\n",
    "            if exists:\n",
    "                command([\"git\", \"-C\", str(REPO), \"switch\", CONFIG[\"BRANCH\"]])\n",
    "            else:\n",
    "                command([\"git\", \"-C\", str(REPO), \"switch\", \"-c\", CONFIG[\"BRANCH\"], \"FETCH_HEAD\"])\n",
    "        command([\"git\", \"-C\", str(REPO), \"merge\", \"--ff-only\", \"FETCH_HEAD\"])\n",
    "\n",
    "if not (REPO / \"src/tools/run_m2_full.py\").is_file():\n",
    "    raise RuntimeError(\"Missing full runner. Check REPO_DIR and fetch the updated m3-data-split branch.\")\n",
    "os.chdir(REPO)\n",
    "if CONFIG[\"INSTALL_DEPENDENCIES\"]:\n",
    "    command([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"-r\", str(REPO / \"src/requirements-m2.txt\")])\n",
    "\n",
    "ENV = os.environ.copy()\n",
    "ENV[\"PYTHONPATH\"] = str(REPO / \"src\") + os.pathsep + ENV.get(\"PYTHONPATH\", \"\")\n",
    "print(\"Python:\", sys.version)\n",
    "print(\"Commit:\", subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip())\n"
