   "source": [
    "# Verify coverage/schema; reference-quality flags may still leave the run partial.\n",
    "selected_inputs = INPUT[\"papers\"][:CONFIG[\"LIMIT\"]] if CONFIG[\"LIMIT\"] else INPUT[\"papers\"]\n",
    "selected_by_id = {paper[\"arxiv_id\"]: paper for paper in selected_inputs}\n",
    "assert SUMMARY[\"publications\"] == len(selected_inputs), \"Missing publication JSON\"\n",
    "assert SUMMARY[\"versions_without_paper_output\"] == 0\n",
    "assert sum(SUMMARY[\"version_statuses\"].values()) == sum(len(p[\"versions\"]) for p in selected_inputs)\n",
    "assert SUMMARY[\"totals\"][\"hierarchy_problems\"] == 0\n",
    "assert EXPORT and EXPORT[\"schema_and_count_checks\"] == \"passed\"\n",
    "assert EXPORT[\"papers_exported\"] == len(selected_inputs)\n",
    "assert len(list((RUN / \"parsed\").glob(\"*.json\"))) == len(selected_inputs)\n",
    "assert not json.loads((RUN / \"paper_failures.json\").read_text(encoding=\"utf-8\"))\n",
    "reported_ids = \"2606.01068 2606.01093 2606.01180 2606.01867 2606.02653 2606.03207 2606.03277 2606.03445 2606.03697 2606.03932 2606.04100 2606.04330 2606.04482 2606.04540 2606.04809 2606.04879 2606.04951 2606.05612\".split()\n",
    "recovered = []\n",
    "for arxiv_id in reported_ids:\n",
    "    if arxiv_id not in selected_by_id:\n",
    "        continue\n",
    "    paper = selected_by_id[arxiv_id]\n",
    "    data = json.loads((RUN / \"parsed\" / (paper[\"paper_key\"] + \".json\")).read_text(encoding=\"utf-8\"))\n",
    "    keys = {entry[\"citation_key\"] for entry in data[\"bibtex\"]}\n",
    "    assert len(keys) == len(data[\"bibtex\"]), arxiv_id\n",
    "    assert data[\"stats\"][\"hierarchy_problems\"] == 0, arxiv_id\n",
    "    for conflict in data.get(\"reference_conflicts\", []):\n",
    "        assert conflict[\"citation_key\"] not in keys, arxiv_id\n",
    "        assert len(set(conflict[\"candidate_keys\"])) >= 2, arxiv_id\n",
    "        assert set(conflict[\"candidate_keys\"]) <= keys, arxiv_id\n",
    "        assert conflict[\"citation_key\"] not in data[\"citation_aliases\"].get(str(conflict[\"version\"]), {}), arxiv_id\n",
    "    recovered.append({\"arxiv_id\": arxiv_id, \"versions\": len(data[\"versions\"]),\n",
    "                      \"parsed_versions\": sum(v[\"status\"] == \"parsed\" for v in data[\"versions\"]),\n",
    "                      \"reference_conflicts\": len(data.get(\"reference_conflicts\", []))})\n",
    "VERIFICATION = {\n",
    "    \"checks\": \"passed\", \"run_status\": RESULT[\"status\"],\n",
    "    \"publication_outputs\": SUMMARY[\"publications\"],\n",
    "    \"version_statuses\": SUMMARY[\"version_statuses\"],\n",
    "    \"version_records\": sum(SUMMARY[\"version_statuses\"].values()),\n",
    "    \"table_rows\": EXPORT[\"table_rows\"],\n",
    "    \"hierarchy_problems\": SUMMARY[\"totals\"][\"hierarchy_problems\"],\n",
    "    \"quality_flags\": SUMMARY[\"quality_flags\"],\n",
    "    \"unresolved_citation_pairs\": SUMMARY[\"unresolved_citation_occurrences\"],\n",
    "    \"previously_failing_papers_checked\": len(recovered),\n",
    "    \"recovered_papers\": recovered,\n",
    "}\n",
    "verification_path = RUN / \"pipeline_verification.json\"\n",
    "verification_temp = verification_path.with_suffix(\".tmp\")\n",
    "verification_temp.write_text(json.dumps(VERIFICATION, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n",
    "verification_temp.replace(verification_path)\n",
    "print(\"PIPELINE VERIFICATION: PASSED\")\n",
    "print(json.dumps({k: v for k, v in VERIFICATION.items() if k != \"recovered_papers\"}, ensure_ascii=False, indent=2))\n",
    "display(pd.DataFrame(recovered))\n",
    "print(\"Saved:\", verification_path)\n",
    "print(\"Coverage/schema checks passed; review partial-source/reference flags separately.\")\n"
   ],
